*.db-shm
.env
.env.local
# Operators keep timestamped .env backups next to the compose file (a real
# deployment had .env.bak-20260801 sitting there). Those hold the mailcow DB
# password, provider API keys and CREDENTIAL_ENCRYPTION_KEY, and the two
# rules above did not match them — so a single `git add -A` in a deployment
# directory would commit live secrets.
.env.*
!.env.example
.DS_Store
*.log
coverage/

# webmail build outputs (Dockerfile rebuilds them in CI)
webmail/dist/
webmail/.vite/
webmail/test-results/
webmail/playwright-report/
test-results/
playwright-report/
.claude/
