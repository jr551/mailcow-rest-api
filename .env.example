# mailcow-rest-api — example configuration
# Copy to .env and edit. All values shown are defaults.

# HTTP server
PORT=3001
HOST=::                 # '::' = dual-stack (IPv4 + IPv6); required when proxied
                        # by nginx that resolves both A and AAAA records
BIND_ADDR=127.0.0.1     # set to 0.0.0.0 only for direct (non-proxied) exposure

# IMAP backend (mailcow Dovecot)
IMAP_HOST=dovecot-mailcow
IMAP_PORT=993
IMAP_SECURE=true
IMAP_TLS_SERVERNAME=
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Auth cache (SQLite WAL)
CACHE_PATH=/data/cache.db
CACHE_TTL_VALID_MS=300000
CACHE_TTL_INVALID_MS=10000

# IMAP connection pool
POOL_MAX=50
POOL_IDLE_MS=30000

# Optional TLS (point at mailcow's existing certs to terminate TLS in this addon)
# TLS_CERT=/opt/mailcow-dockerized/data/assets/ssl/cert.pem
# TLS_KEY=/opt/mailcow-dockerized/data/assets/ssl/key.pem

# Mailcow network override (only needed if mailcow renames its network)
MAILCOW_NETWORK=mailcowdockerized_mailcow-network

# Mistral OCR + AI (one MISTRAL_API_KEY powers both OCR and AI summarize/draft).
# Leave unset to disable the OCR endpoint and the /v1/ai/* endpoints.
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_OCR_TIMEOUT_MS=60000
# MISTRAL_CHAT_MODEL=mistral-small-latest
# MISTRAL_CHAT_TIMEOUT_MS=30000
# MISTRAL_CHAT_MAX_INPUT_CHARS=24000

# Reasoning models bill hidden thinking tokens against max_tokens before
# emitting any visible content, so a small budget returns an empty reply.
# Default 'none' keeps answers deterministic and cheap; set low/medium/high
# to re-enable deliberation, or empty to omit the parameter entirely.
# LLM_REASONING_EFFORT=none

# Strip credentials (passwords, API keys, JWTs, card numbers, one-time
# codes) from prompts before they leave this server. Pattern-based and
# deterministic — no model involved. On by default: the AI features work
# fine without the secret, and sending one to a third party can't be undone.
# LLM_SCRUB_SECRETS=true

# Decoy requests per real request (0-5). Sends variants of each prompt with
# names, addresses and numbers randomised, so the provider's stored
# transcript is mostly conversations that never happened.
#
# Read the trade-off before enabling: it multiplies token spend by
# (1 + count), and it does NOT hide that this account uses the service, when,
# or roughly how much text. Off by default.
# LLM_DECOY_COUNT=0

# Completion cache (sqlite). Rows are sealed with a key derived from the
# server key and the user's own password, so the file is inert without both
# and a password change simply reads as a miss. Identical requests from the same user are
# answered locally instead of hitting the provider. Scoped per user.
# AI_CACHE_ENABLED=true
# AI_CACHE_PATH=/data/ai-cache.db  (defaults beside CACHE_PATH)
# AI_CACHE_TTL_MS=43200000
# AI_CACHE_MAX_ENTRIES=5000

# Key for encrypting stored mailbox passwords (session renewal, tracking
# pixel notifications). Any string works: 32-byte hex/base64 is used
# directly, anything else is stretched with scrypt. Generate one with
#   openssl rand -hex 32
# When unset the server writes a key next to the databases and warns —
# workable, but then a backup of the data volume carries the key with the
# ciphertext it protects, so prefer setting it here.
# CREDENTIAL_ENCRYPTION_KEY=

# Browser origins allowed to reach a user's Drive bucket. The webmail talks
# to S3 directly, so a bucket without matching CORS rules cannot be opened
# at all. Comma-separated; falls back to PUBLIC_BASE_URL.
# DRIVE_CORS_ORIGINS=https://webmail.example.com

# Which hops may set X-Forwarded-For. Defaults to trusting only proxies on
# loopback/private networks (the Docker topology). `true` is treated the
# same way rather than "trust any client", which would let anyone forge
# their source IP and bypass the rate limiter and IP allowlist. Accepts a
# comma-separated IP/CIDR list, a hop count, or false.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# The provider key stays server-side: the webmail sends chat requests to
# /v1/ai/llm/chat/completions with its own session token, and this process
# attaches the key on the way out. Nothing AI-related is exposed to browsers.

# ElevenLabs text-to-speech (voice replies in the webmail AI chat).
# Leave unset to disable spoken replies (voice mode still works as text-only).
# ELEVENLABS_API_KEY=

# Static webmail mount for combined/private deployments. The public
# mailcow-rest-api Docker image does not ship the webmail dist; use
# ghcr.io/jr551/mailcow-rest-api-webmail separately for the public frontend.
# WEBMAIL_ENABLED=true
# WEBMAIL_DIST=/app/webmail/dist

# SMTP send configuration.
# Requires SMTP_HOST to be set. Uses the user's IMAP credentials for SMTP AUTH.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# OCR result cache (content-addressable, separate SQLite file).
# Key = sha256(attachment_bytes) + model. No TTL — OCR is deterministic.
# OCR_CACHE_ENABLED=true
# OCR_CACHE_PATH=/data/ocr-cache.db
# OCR_CACHE_MAX_ENTRIES=1000

# Web Push subscription store (separate SQLite file).
# PUSH_DB_PATH=/data/push.db

# Web Push (VAPID). Generate once with `npx web-push generate-vapid-keys`.
# Without these, /v1/push/subscribe accepts but the poller never delivers.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# PUSH_POLL_INTERVAL_MS=300000

# Open/click tracking store (separate SQLite file).
# TRACKING_DB_PATH=/data/tracking.db

# Session lifetime cap. Sliding TTL (CACHE_TTL_VALID_MS) extends idle sessions,
# but a hard cap forces re-auth after this many ms regardless of activity.
# SESSION_MAX_LIFETIME_MS=86400000

# Network access
# Optional comma-separated allowlist of CIDRs / IPs allowed to reach the API.
# Empty (default) = allow all. 127.0.0.1 and ::1 are always allowed so the
# Docker healthcheck cannot lock itself out.
# IP_ALLOWLIST=
# Honor X-Forwarded-For from upstream proxies (default: true). Set to false
# only if the addon is exposed directly to clients without a proxy.
# TRUST_PROXY=true

# Per-IP rate limit (anti-abuse backstop, not a per-user throttle — a webmail
# client legitimately bursts many requests when opening a mailbox). Caps
# credential-stuffing sweeps against the IMAP LOGIN each failed Basic-auth
# attempt triggers. 127.0.0.1/::1 are always exempt. Set RATE_LIMIT_ENABLED=false
# to disable entirely (e.g. behind a proxy that already rate-limits).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# SOGo CalDAV (optional — leave SOGO_URL unset to disable calendar endpoints)
# SOGO_URL=http://nginx-mailcow/SOGo
# CALDAV_TLS_REJECT_UNAUTHORIZED=true

# S3 Drive (optional client-side file manager)
# Set S3_DRIVE_ENABLED=true and choose a provider:
#   'json'  — static per-user config from a JSON file (see config/drive-users.example.json)
#   'b2'    — Backblaze B2 auto-provisioning (creates buckets + keys per user on demand)
# S3_DRIVE_ENABLED=false
# S3_DRIVE_PROVIDER=json
# S3_DRIVE_USERS_JSON=./data/drive-users.json
# S3_DRIVE_DEFAULT_QUOTA_GB=5

# Backblaze B2 master key (only used when S3_DRIVE_PROVIDER=b2)
# The server uses this to authorize with B2, create private buckets, and issue
# per-user application keys scoped to a single bucket.
# B2_KEY_ID=***REDACTED_B2_ID***
# B2_APPLICATION_KEY=***REDACTED_B2_APP***

# Logging
LOG_LEVEL=info

# MCP server (only used when running `npm run mcp` or the `imap-rest-mcp` bin)
# Tells the MCP server where the REST API lives and which mailcow account it
# should authenticate as. Not consumed by the REST server itself.
# IMAP_REST_BASE_URL=http://127.0.0.1:3001
# IMAP_REST_USER=user@example.com
# IMAP_REST_PASS=
# IMAP_REST_TIMEOUT_MS=90000

# ---------------------------------------------------------------------------
# Webhook conversion accounts
# ---------------------------------------------------------------------------
# Mail arriving in these mailboxes is POSTed to a webhook and then DELETED
# from the mailbox. The message is only deleted after the webhook answers
# 2xx; a failure leaves it in place and retries with backoff (1m, 5m, 15m,
# 1h, 3h, 6h, 12h, then daily) up to WEBHOOK_MAX_ATTEMPTS, after which the
# message is left alone for a human to deal with.
#
# `password` is the mailbox's own IMAP password — this runs in the
# background with no user session to borrow credentials from.
# `secret` is optional; when set, the POST body is signed with HMAC-SHA256
# and sent as `X-Webhook-Signature: sha256=<hex>`. Verify it against the
# raw request body. `mailbox` defaults to INBOX.
#
# WEBHOOK_ACCOUNTS=[{"address":"forms@example.com","password":"…","url":"https://hooks.example.com/mail","secret":"…"}]
# WEBHOOK_DB_PATH=/data/webhooks.db
# WEBHOOK_POLL_INTERVAL_MS=60000
# WEBHOOK_TIMEOUT_MS=15000
# WEBHOOK_MAX_ATTEMPTS=14
# WEBHOOK_MAX_MESSAGE_BYTES=26214400
#
# Attachment bytes are included in the payload (base64) so the receiver
# doesn't have to re-parse MIME out of the raw source. Bounded, because
# base64 adds a third on top and a 25 MB mail would otherwise become ~33 MB
# of JSON. Anything over the cap is still listed, with `included: false` and
# an `omittedReason`, so nothing disappears silently.
# WEBHOOK_INCLUDE_ATTACHMENTS=true
# WEBHOOK_MAX_ATTACHMENT_BYTES=10485760
# WEBHOOK_MAX_ATTACHMENTS_TOTAL_BYTES=20971520
