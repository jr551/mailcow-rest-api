{
    "name": "mailcow-rest-api",
    "version": "0.16.0",
    "description": "Mailcow add-on REST API, OpenAPI UI, and optional MCP server for mailbox, send, calendar, drive, push, and account workflows.",
    "main": "src/server.js",
    "files": [
        "src/",
        "bin/",
        "install/",
        "Dockerfile",
        "docker-compose.yml",
        ".env.example",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "mcp": "node src/mcp/index.js",
        "test": "node --test --test-concurrency=1 test/unit/*.test.js"
    },
    "bin": {
        "imap-rest-mcp": "bin/imap-rest-mcp"
    },
    "keywords": [
        "imap",
        "mailcow",
        "rest",
        "addon",
        "ocr",
        "mistral",
        "mcp",
        "model-context-protocol"
    ],
    "license": "MIT",
    "author": "John Rowe",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jr551/mailcow-rest-api.git"
    },
    "bugs": {
        "url": "https://github.com/jr551/mailcow-rest-api/issues"
    },
    "homepage": "https://github.com/jr551/mailcow-rest-api#readme",
    "dependencies": {
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/sensible": "6.0.5",
        "@fastify/static": "^10.1.3",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@modelcontextprotocol/sdk": "1.30.0",
        "better-sqlite3": "13.0.3",
        "dotenv": "^17.4.2",
        "fast-xml-parser": "^5.11.1",
        "fastify": "^5.12.4",
        "imapflow": "^2.0.3",
        "mysql2": "^3.22.3",
        "nodemailer": "^10.0.10",
        "pino": "10.3.1",
        "undici": "^8.10.2",
        "web-push": "^3.6.7",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "pino-pretty": "13.1.3",
        "puppeteer-core": "^25.10.0"
    }
}
